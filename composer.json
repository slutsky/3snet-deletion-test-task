{
    "name": "slutsky/3snet-deletion-test-task",
    "description": "A service for checking whether entities can be deleted and for retrieving a list of dependent objects.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nikita Slutsky",
            "email": "slutsky6@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "doctrine/orm": "^3.6",
        "psr/log": "^3.0",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/config": "^8.1",
        "symfony/runtime": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Shared\\Deletion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shared\\Deletion\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
